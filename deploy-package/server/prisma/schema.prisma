// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String
  email         String?        @unique
  role          String         @default("user") // superadmin, admin, observer
  twoFASecret   String?
  
  // Extended Profile
  nickname      String?
  steamId       String?        @unique // Link to in-game SteamID
  gender        String?        // male, female, other
  birthday      DateTime?
  region        String?
  phone         String?
  wechat        String?
  avatarUrl     String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  auditLogs     AuditLog[]
  teamMembers   TeamMember[]
  adminSessions AdminAttendance[]
  serverPermissions ServerPermission[]
  loginHistory  LoginHistory[]
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ip        String
  userAgent String?
  location  String?  // Optional: derived from IP
  timestamp DateTime @default(now())
  status    String   // success, failed

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Server {
  id            String         @id @default(uuid())
  name          String
  host          String
  rconPort      Int
  rconPassword  String
  queryPort     Int?
  
  // File Access
  fileProtocol  String?        // local, ftp, sftp
  fileHost      String?
  filePort      Int?
  fileUser      String?
  filePassword  String?
  filePath      String?        // Directory path containing Admins.cfg
  welcomeMessage String?       // Message to broadcast when player joins

  isPublished   Boolean        @default(true) // 是否已上架

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  logs          Log[]
  adminSessions AdminAttendance[]
  whitelists    Whitelist[]
  broadcasts    Broadcast[]
  metrics       ServerMetric[]
  userPermissions ServerPermission[]
  notificationRules NotificationRule[]
  scheduledTasks ScheduledTask[]
  matches       Match[]
  scrimMatches  ScrimMatch[]
  gameEvents    GameEvent[]

  @@unique([host, rconPort])
}

model ServerPermission {
  id          String   @id @default(uuid())
  userId      String
  serverId    String
  permissions String   // JSON array string: ["control", "console", "files", "admins"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

model Player {
  steamId       String         @id
  nameHistory   String         // JSON array stored as string
  reputation    Int            @default(0)
  points        Int            @default(0)
  totalPlaytime Int            @default(0) // in minutes (本服时长)
  steamPlaytime Int            @default(0) // in minutes (Steam总时长)
  lastSteamSync DateTime?      // 上次同步Steam数据的时间
  firstSeen     DateTime       @default(now())
  lastSeen      DateTime       @default(now())
  
  bans          Ban[]
  whitelists    Whitelist[]
  notes         PlayerNote[]
}

model PlayerNote {
  id        String   @id @default(uuid())
  steamId   String
  authorId  String?  // Admin's user ID
  authorName String? // Admin's username (snapshot)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  player    Player   @relation(fields: [steamId], references: [steamId])
}

model Ban {
  id        String   @id @default(uuid())
  steamId   String
  reason    String
  adminId   String?
  expiresAt DateTime?
  type      String   @default("steam_id") // steam_id, ip
  createdAt DateTime @default(now())
  
  player    Player   @relation(fields: [steamId], references: [steamId])
}

model Whitelist {
  id        String    @id @default(uuid())
  steamId   String
  serverId  String
  expiresAt DateTime?
  comment   String?
  createdAt DateTime  @default(now())
  
  player    Player    @relation(fields: [steamId], references: [steamId])
  server    Server    @relation(fields: [serverId], references: [id])
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  tag         String       @unique
  ownerId     String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  members     TeamMember[]
  
  homeMatches ScrimMatch[] @relation("TeamA")
  awayMatches ScrimMatch[] @relation("TeamB")
}

model TeamMember {
  teamId   String
  userId   String
  role     String   @default("member") // owner, admin, member
  joinedAt DateTime @default(now())
  
  team     Team     @relation(fields: [teamId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  
  @@id([teamId, userId])
}

model CDK {
  code      String    @id
  type      String    // points, vip, item
  value     Int       // amount of points or days of vip
  isUsed    Boolean   @default(false)
  usedBy    String?
  createdAt DateTime  @default(now())
}

model AdminAttendance {
  id           String    @id @default(uuid())
  adminId      String
  serverId     String
  sessionStart DateTime  @default(now())
  sessionEnd   DateTime?
  duration     Int?      // in minutes
  
  admin        User      @relation(fields: [adminId], references: [id])
  server       Server    @relation(fields: [serverId], references: [id])
}

model Log {
  id        String   @id @default(uuid())
  serverId  String
  type      String   // info, warning, error, chat, kill, join, leave
  content   String
  timestamp DateTime @default(now())
  
  server    Server   @relation(fields: [serverId], references: [id])
}

model LogState {
  id        String   @id @default(uuid())
  serverId  String   @unique
  filePath  String
  inode     BigInt   @default(0)
  size      BigInt   @default(0)
  lastRead  BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model NotificationRule {
  id            String   @id @default(uuid())
  serverId      String?
  name          String
  description   String?
  type          String   // "server_down", "player_count", "log_keyword", "system_resource"
  condition     String   // JSON string: { "operator": ">", "value": 90 }
  channels      String   // JSON string: ["sms"]
  targets       String   // JSON string: ["13800000000"]
  enabled       Boolean  @default(true)
  cooldown      Int      @default(300) // seconds
  lastTriggered DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  server        Server?  @relation(fields: [serverId], references: [id])
  logs          NotificationLog[]
}

model ScheduledTask {
  id          String   @id @default(uuid())
  serverId    String
  name        String
  description String?
  type        String   // "restart", "broadcast", "rcon_command"
  cron        String?  // Cron expression (e.g. "0 4 * * *")
  payload     String?  // Command or message
  retryCount  Int      @default(0)
  retryDelay  Int      @default(30)
  enabled     Boolean  @default(true)
  lastRun     DateTime?
  nextRun     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  server      Server   @relation(fields: [serverId], references: [id])
  executions  ScheduledTaskExecution[]
}

model ScheduledTaskExecution {
  id          String        @id @default(uuid())
  taskId      String
  status      String
  attempt     Int           @default(1)
  totalAttempts Int         @default(1)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  error       String?
  output      String?

  task        ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
}

model NotificationLog {
  id          String   @id @default(uuid())
  ruleId      String?
  type        String   // sms, email
  target      String
  content     String
  status      String   // success, failed
  error       String?
  createdAt   DateTime @default(now())
  
  rule        NotificationRule? @relation(fields: [ruleId], references: [id])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // info, warn, error, debug
  category  String   // system, application, access, error, etc.
  source    String   // filename or service name
  message   String
  metadata  String?  // JSON string for parsed fields
  timestamp DateTime @default(now())
  
  @@index([timestamp])
  @@index([level])
  @@index([category])
}

model ServerMetric {
  id          String   @id @default(uuid())
  serverId    String
  playerCount Int
  maxPlayers  Int?
  tps         Float?   // reserved for future use
  timestamp   DateTime @default(now())

  server      Server   @relation(fields: [serverId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  target    String?
  timestamp DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}

model SquadGroup {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions String       // e.g. "kick,ban,changemap"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  admins      SquadAdmin[]
}

model SquadAdmin {
  id        String     @id @default(uuid())
  steamId   String     @unique
  name      String?
  groupId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  group     SquadGroup @relation(fields: [groupId], references: [id])
}

model Match {
  id        String      @id @default(uuid())
  serverId  String
  map       String
  layer     String?
  startTime DateTime    @default(now())
  endTime   DateTime?
  winner    String?     // "Team1", "Team2"
  score     String?     // "100-0"
  
  server    Server      @relation(fields: [serverId], references: [id])
  events    GameEvent[]
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model GameEvent {
  id        String   @id @default(uuid())
  matchId   String?
  serverId  String
  type      String   // KILL, REVIVE, VEHICLE_DESTROY
  data      String   // JSON string
  timestamp DateTime @default(now())

  match     Match?   @relation(fields: [matchId], references: [id])
  server    Server   @relation(fields: [serverId], references: [id])
}

model ScrimMatch {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  serverId    String?
  teamAId     String?
  teamBId     String?
  
  teamA       Team?    @relation("TeamA", fields: [teamAId], references: [id])
  teamB       Team?    @relation("TeamB", fields: [teamBId], references: [id])
  server      Server?  @relation(fields: [serverId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Broadcast {
  id        String   @id @default(uuid())
  serverId  String
  content   String
  interval  Int      // in seconds, e.g., 600 for 10 minutes
  enabled   Boolean  @default(true)
  lastRun   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  server    Server   @relation(fields: [serverId], references: [id])
}
