# ==================== 数据库配置 ====================
# SQLite 数据库文件路径（开发环境）
DATABASE_URL=file:./server/prisma/dev.db

# PostgreSQL 连接字符串（生产环境，取消注释并使用）
# DATABASE_URL=postgresql://user:password@localhost:5432/squad_panel

# ==================== JWT 认证配置 ====================
# JWT 密钥（生产环境请修改为随机字符串）
JWT_SECRET=super-secret-key-change-this-in-production

# JWT 过期时间（默认 7 天）
JWT_EXPIRES_IN=7d

# ==================== 服务器配置 ====================
# 后端服务端口
PORT=3000

# 前端构建时 API 地址（开发环境可留空并使用 /api 代理）
VITE_API_URL=http://localhost:3000

# ==================== 文件上传配置 ====================
# 最大上传文件大小（MB）
MAX_FILE_SIZE=10

# 上传目录
UPLOAD_DIR=./uploads

# ==================== 日志配置 ====================
# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=./logs/app.log

# ==================== RCON 配置 ====================
# RCON 连接超时时间（毫秒）
RCON_TIMEOUT=5000

# RCON 最大重试次数
RCON_MAX_RETRIES=3

# ==================== SFTP 配置 ====================
# SFTP 连接超时时间（毫秒）
SFTP_TIMEOUT=10000

# ==================== 安全配置 ====================
# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 会话过期时间（小时）
SESSION_EXPIRES_HOURS=24

# ==================== 其他配置 ====================
# 启用 CORS（开发环境设为 true）
CORS_ENABLED=true

# 允许的来源（生产环境修改为实际域名）
CORS_ORIGIN=*

# 启用调试模式
DEBUG=false
